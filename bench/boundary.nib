// How much does a call from Wasm into the DOM cost? Each export makes `n` calls of one kind.

extern call Element.hasAttribute(name: ext): bool
extern get Node.firstChild: ext
extern get Element.clientWidth: i32
extern set Element.scrollTop: i32
extern call Performance.now(): f64
extern fn Math.hypot(a: f64, b: f64): f64

export fn method(el: ext, n: i32): i32 { let s = 0; for i in 0..n { s += hasAttribute(el, "id") as i32 } return s }
export fn getter(el: ext, n: i32): i32 { let s = 0; for i in 0..n { s += isnull(firstChild(el)) as i32 } return s }
export fn layout_getter(el: ext, n: i32): i32 { let s = 0; for i in 0..n { s += clientWidth(el) } return s }
export fn setter(el: ext, n: i32) { for i in 0..n { set_scrollTop(el, i & 1) } }
export fn no_arguments(p: ext, n: i32): f64 { let s: f64 = 0.0; for i in 0..n { s += now(p) } return s }
export fn plain_function(n: i32): f64 { let s: f64 = 0.0; for i in 0..n { s += hypot(3.0, i as f64) } return s }
