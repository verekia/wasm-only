// A fixed-timestep game loop.
//
// Import this and define two functions. They are called by name, so the calls are direct:
//
//   fn update(dt: f32)        advance the game by one tick; dt is always TICK
//   fn render(blend: f32)     draw; blend in 0..1 says how far the display is past the last tick
//
// Updating in fixed steps keeps the simulation identical on a 60 Hz and a 144 Hz display.
// Drawing between ticks (position = previous + (current - previous) * blend) keeps motion smooth.

import "std/dom"
import "std/input"

const TICK = 1.0 / 120.0

var loop_then: f64 = 0.0
var loop_owed: f64 = 0.0         // time the simulation has not caught up with yet

fn loop_start() { requestAnimationFrame(loop_first) }

fn loop_first(now: f64) {
  loop_then = now
  requestAnimationFrame(loop_frame)
}

fn loop_frame(now: f64) {
  loop_owed += min((now - loop_then) * 0.001, 0.1)       // after a pause, resume rather than replay it
  loop_then = now
  while loop_owed >= TICK {
    update(TICK)
    input_end()
    loop_owed -= TICK
  }
  render((loop_owed / TICK) as f32)
  requestAnimationFrame(loop_frame)
}
