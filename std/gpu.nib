// WebGPU. Descriptors are ordinary object literals: { size: 64, usage: UNIFORM | COPY_DST }.

import "std/dom"
import "std/mem"

// ---- getting started
//
//   gpu_start(canvas, ready, failed)
//
// asks for a device and configures the canvas for it, then calls `ready`. If any step is
// missing (no WebGPU, no adapter) it calls `failed` instead. Afterwards these are set:

var gpu_canvas: ext
var gpu_device: ext
var gpu_queue: ext
var gpu_context: ext
var gpu_format: ext
var gpu_width = 1                 // the canvas size in device pixels, kept by gpu_fit()
var gpu_height = 1

fn gpu_start(canvas: ext, ready: func, failed: func) {
  gpu_canvas = canvas
  let api = resolved(Promise, prop(navigator, "gpu"))
  // each step runs inside the promise chain, so whatever is missing rejects it and lands in `failed`
  on_error(then(then(then(then(api, gpu_step_adapter), gpu_step_device), gpu_step_configure), ready), failed)
}
fn gpu_step_adapter(api: ext): ext {
  gpu_format = getPreferredCanvasFormat(api)
  return requestAdapter(api)
}
fn gpu_step_device(adapter: ext): ext { return requestDevice(adapter) }
fn gpu_step_configure(device: ext) {
  gpu_device = device
  gpu_queue = device_queue(device)
  gpu_context = getContext(gpu_canvas, "webgpu")
  configure(gpu_context, { device, format: gpu_format })
}

// Matches the canvas's pixel size to its size on screen. Call at start and on window "resize".
fn gpu_fit() {
  let scale = devicePixelRatio(window)
  gpu_width = max((clientWidth(gpu_canvas) as f64 * scale) as i32, 1)
  gpu_height = max((clientHeight(gpu_canvas) as f64 * scale) as i32, 1)
  set_width(gpu_canvas, gpu_width)
  set_height(gpu_canvas, gpu_height)
}

// A buffer holding `size` bytes of Wasm memory starting at `data`.
fn gpu_buffer(data: i32, size: i32, usage: i32): ext {
  let b = createBuffer(gpu_device, { size, usage: usage | COPY_DST })
  writeBuffer(gpu_queue, b, 0, memory_buffer(), data, size)
  return b
}

// ---- the API

extern call GPU.requestAdapter(): ext                        // a promise
extern call GPU.getPreferredCanvasFormat(): ext
extern call GPUAdapter.requestDevice(): ext                  // a promise
extern call HTMLCanvasElement.getContext(kind: ext): ext
extern call GPUCanvasContext.configure(desc: ext)
extern call GPUCanvasContext.getCurrentTexture(): ext

extern get GPUDevice.queue: ext as device_queue
extern call GPUDevice.createShaderModule(desc: ext): ext
extern call GPUDevice.createRenderPipeline(desc: ext): ext
extern call GPUDevice.createBuffer(desc: ext): ext
extern call GPUDevice.createTexture(desc: ext): ext
extern call GPUDevice.createBindGroup(desc: ext): ext
extern call GPUDevice.createCommandEncoder(): ext
extern call GPURenderPipeline.getBindGroupLayout(index: i32): ext
extern call GPUTexture.createView(): ext
extern call GPUTexture.destroy() as destroy_texture

// writeBuffer(queue, buffer, bufferOffset, data, dataOffset, size): with an ArrayBuffer as
// `data`, the last two are in bytes, so Wasm memory uploads straight from an address.
extern call GPUQueue.writeBuffer(buffer: ext, at: i32, data: ext, start: i32, size: i32)
extern call GPUQueue.submit(commands: ext)

extern call GPUCommandEncoder.beginRenderPass(desc: ext): ext
extern call GPUCommandEncoder.finish(): ext
extern call GPURenderPassEncoder.setPipeline(pipeline: ext)
extern call GPURenderPassEncoder.setBindGroup(index: i32, group: ext)
extern call GPURenderPassEncoder.setVertexBuffer(slot: i32, buffer: ext)
extern call GPURenderPassEncoder.setIndexBuffer(buffer: ext, format: ext)
extern call GPURenderPassEncoder.draw(vertices: i32, ...)             // then: instances
extern call GPURenderPassEncoder.drawIndexed(indices: i32, ...)       // then: instances
extern call GPURenderPassEncoder.end()

// GPUBufferUsage
const COPY_SRC = 0x04
const COPY_DST = 0x08
const INDEX = 0x10
const VERTEX = 0x20
const UNIFORM = 0x40
const STORAGE = 0x80
// GPUTextureUsage
const TEXTURE_BINDING = 0x04
const RENDER_ATTACHMENT = 0x10
