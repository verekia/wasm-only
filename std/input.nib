// Keyboard and pointer state, read by polling.
//
// A game names its own actions as bits and maps physical keys onto them:
//
//   const LEFT = 1
//   const JUMP = 2
//   input_init(canvas, { ArrowLeft: LEFT, KeyA: LEFT, Space: JUMP })
//
//   if held(LEFT) { ... }          // down right now
//   if hit(JUMP) { ... }           // went down since the last input_end()
//
// The keys are KeyboardEvent.code values: they name positions, so WASD works on every layout.

import "std/dom"

var input_held: u32
var input_hit: u32
var input_keys: ext

var pointer_x: f32               // in CSS pixels, from the surface's top left corner
var pointer_y: f32
var pointer_held = false
var pointer_hit = false          // went down since the last input_end()

inline fn held(actions: u32): bool { return input_held & actions != 0 }
inline fn hit(actions: u32): bool { return input_hit & actions != 0 }

// Forgets what was hit. Call after each update that looked at it.
fn input_end() {
  input_hit = 0
  pointer_hit = false
}

fn input_init(surface: ext, keys: ext) {
  input_keys = keys
  on(window, "keydown", input_key_down)
  on(window, "keyup", input_key_up)
  on(window, "blur", input_release)                // a key released in another window would stay held
  on(surface, "pointerdown", input_pointer_down)
  on(surface, "pointermove", input_pointer_move)
  on(surface, "pointerup", input_pointer_up)
  on(surface, "pointercancel", input_pointer_up)
}

extern fn Reflect.get(keys: ext, code: ext): u32 as input_action     // 0 for a key that is not mapped

fn input_key_down(e: ext) {
  let action = input_action(input_keys, code(e))
  if action == 0 || ctrlKey(e) || metaKey(e) { return }      // leave browser shortcuts alone
  preventDefault(e)                                           // keep arrows and space from scrolling the page
  input_hit |= action & ~input_held                           // held keys repeat; only the first press is a hit
  input_held |= action
}

fn input_key_up(e: ext) { input_held &= ~input_action(input_keys, code(e)) }

fn input_release() {
  input_held = 0
  pointer_held = false
}

fn input_pointer_move(e: ext) {
  pointer_x = offsetX(e) as f32
  pointer_y = offsetY(e) as f32
}

fn input_pointer_down(e: ext) {
  setPointerCapture(target(e), pointerId(e))        // keep following a drag that leaves the surface
  input_pointer_move(e)
  pointer_held = true
  pointer_hit = true
}

fn input_pointer_up(e: ext) { pointer_held = false }
