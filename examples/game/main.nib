// A small arcade game: steer a cube around a floor, collect the bright cubes, avoid the dark
// ones. Each one collected makes the next harder.
//
// What it exercises: a fixed-timestep loop (std/loop), keyboard and pointer input (std/input),
// lists and a per-frame arena on the heap (std/mem), and one instanced draw call for everything.

import "std/math"
import "std/dom"
import "std/gpu"
import "std/mem"
import "std/input"
import "std/loop"
import "../shared/cube"

// ---- rules

const FIELD = 9.0                 // the floor reaches from -FIELD to +FIELD
const PLAYER_SIZE = 0.5
const PLAYER_SPEED = 11.0
const HAZARD_SIZE = 0.6
const ORB_SIZE = 0.28
const ORBS = 3
const MOST_HAZARDS = 40
const MOST_SPARKS = 400

const LEFT = 1                    // actions; index.html's keys are mapped onto them in main()
const RIGHT = 2
const UP = 4
const DOWN = 8
const START = 16

const READY = 0
const PLAYING = 1
const OVER = 2

// ---- state

struct Hazard { x: f32, z: f32, vx: f32, vz: f32, was_x: f32, was_z: f32 }     // was_*: one tick ago, for drawing between ticks
struct Orb { x: f32, z: f32 }
struct Spark { x: f32, y: f32, z: f32, vx: f32, vy: f32, vz: f32, life: f32, r: f32, g: f32, b: f32 }

static hazards: [List; 1]
static orbs: [List; 1]
static sparks: [List; 1]

var state = READY
var clock: f32 = 0
var score = 0
var best = 0
var player_x: f32 = 0
var player_z: f32 = 0
var player_vx: f32 = 0
var player_vz: f32 = 0
var player_was_x: f32 = 0
var player_was_z: f32 = 0

var score_label: ext
var best_label: ext
var message: ext

// ---- startup

extern fn Math.random(): f64 as entropy

export fn main(exports: ext) {
  memory_bind(exports)
  score_label = getElementById(document, "score")
  best_label = getElementById(document, "best")
  message = getElementById(document, "message")
  let canvas = getElementById(document, "view")

  list_init(hazards, sizeof(Hazard), 8)
  list_init(orbs, sizeof(Orb), ORBS)
  list_init(sparks, sizeof(Spark), 64)
  random_seed((entropy() * 4294967295.0) as u32)
  place_everything()

  input_init(canvas, {
    ArrowLeft: LEFT, KeyA: LEFT, ArrowRight: RIGHT, KeyD: RIGHT
    ArrowUp: UP, KeyW: UP, ArrowDown: DOWN, KeyS: DOWN
    Enter: START, Space: START
  })
  gpu_start(canvas, start, unsupported)
}

fn unsupported() { set_textContent(message, "WebGPU is not available in this browser.") }

fn start() {
  scene_init()
  loop_start()
}

// ---- the game

fn place_everything() {
  hazards.count = 0
  orbs.count = 0
  player_x = 0
  player_z = 0
  player_vx = 0
  player_vz = 0
  player_was_x = 0
  player_was_z = 0
  for i in 0..3 { add_hazard() }
  for i in 0..ORBS { place_orb(list_add(orbs) as *Orb) }
}

fn restart() {
  score = 0
  set_textContent(score_label, 0)
  set_textContent(message, "")
  place_everything()
  state = PLAYING
}

fn far_from_player(x: f32, z: f32, distance: f32): bool {
  let dx = x - player_x
  let dz = z - player_z
  return dx * dx + dz * dz > distance * distance
}

fn add_hazard() {
  let x = 0.0
  let z = 0.0
  loop {
    x = (random() * 2.0 - 1.0) * (FIELD - HAZARD_SIZE)
    z = (random() * 2.0 - 1.0) * (FIELD - HAZARD_SIZE)
    if far_from_player(x, z, 7.0) { break }
  }
  let angle = random() * TAU
  let speed = 3.5 + score as f32 * 0.12
  let h = list_add(hazards) as *Hazard
  h.x = x
  h.z = z
  h.was_x = x
  h.was_z = z
  h.vx = cos(angle) * speed
  h.vz = sin(angle) * speed
}

fn place_orb(o: *Orb) {
  loop {
    o.x = (random() * 2.0 - 1.0) * (FIELD - 1.0)
    o.z = (random() * 2.0 - 1.0) * (FIELD - 1.0)
    if far_from_player(o.x, o.z, 4.0) { break }
  }
}

fn burst(x: f32, z: f32, count: i32, r: f32, g: f32, b: f32) {
  for i in 0..count {
    if sparks.count == MOST_SPARKS { return }
    let angle = random() * TAU
    let out = 2.0 + random() * 5.0
    let s = list_add(sparks) as *Spark
    s.x = x
    s.y = 0.4
    s.z = z
    s.vx = cos(angle) * out
    s.vy = 4.0 + random() * 6.0
    s.vz = sin(angle) * out
    s.life = 0.5 + random() * 0.6
    s.r = r
    s.g = g
    s.b = b
  }
}

fn game_over() {
  state = OVER
  burst(player_x, player_z, 80, 0.91, 0.38, 0.23)
  if score > best {
    best = score
    set_textContent(best_label, best)
  }
  set_textContent(message, "Game over. Press Enter or tap to play again.")
}

// One tick. Called by std/loop at a fixed rate, whatever the display's refresh rate.
fn update(dt: f32) {
  clock += dt
  update_sparks(dt)
  if state != PLAYING {
    if hit(START) || pointer_hit { restart() }
    return
  }

  // steer with the keys, or towards the spot on the floor under a held pointer
  let ax = (held(RIGHT) as i32 - held(LEFT) as i32) as f32
  let az = (held(DOWN) as i32 - held(UP) as i32) as f32
  if pointer_held && aim() {
    ax = (aim_x - player_x) * 2.0
    az = (aim_z - player_z) * 2.0
  }
  let length = sqrt(ax * ax + az * az)
  if length > 1.0 {
    ax = ax / length
    az = az / length
  }
  let ease = min(dt * 12.0, 1.0)
  player_vx += (ax * PLAYER_SPEED - player_vx) * ease
  player_vz += (az * PLAYER_SPEED - player_vz) * ease
  player_was_x = player_x
  player_was_z = player_z
  player_x = clamp(player_x + player_vx * dt, PLAYER_SIZE - FIELD, FIELD - PLAYER_SIZE)
  player_z = clamp(player_z + player_vz * dt, PLAYER_SIZE - FIELD, FIELD - PLAYER_SIZE)

  let wall = FIELD - HAZARD_SIZE
  let reach = PLAYER_SIZE + HAZARD_SIZE - 0.15           // a little forgiving
  let all = hazards.items as *Hazard
  for i in 0..hazards.count {
    let h = &all[i]
    h.was_x = h.x
    h.was_z = h.z
    h.x += h.vx * dt
    h.z += h.vz * dt
    if abs(h.x) > wall {
      h.x = h.x > 0.0 ? wall : -wall
      h.vx = -h.vx
    }
    if abs(h.z) > wall {
      h.z = h.z > 0.0 ? wall : -wall
      h.vz = -h.vz
    }
    if abs(h.x - player_x) < reach && abs(h.z - player_z) < reach {
      game_over()
      return
    }
  }

  let grab = PLAYER_SIZE + ORB_SIZE + 0.1
  let each = orbs.items as *Orb
  for i in 0..orbs.count {
    let o = &each[i]
    if abs(o.x - player_x) < grab && abs(o.z - player_z) < grab {
      burst(o.x, o.z, 14, 1.0, 0.85, 0.3)
      place_orb(o)
      score += 1
      set_textContent(score_label, score)
      if score % 3 == 0 && hazards.count < MOST_HAZARDS { add_hazard() }
    }
  }
}

// Finds where the pointer's ray meets the floor. False when it points above the horizon.
var aim_x: f32 = 0
var aim_z: f32 = 0

fn aim(): bool {
  let nx = (pointer_x / view_width * 2.0 - 1.0) * view_aspect / view_focal
  let ny = (1.0 - pointer_y / view_height * 2.0) / view_focal
  // the rows of a view matrix are the camera's side, up and backward axes
  let dx = view[0].x * nx + view[0].y * ny - view[0].z
  let dy = view[1].x * nx + view[1].y * ny - view[1].z
  let dz = view[2].x * nx + view[2].y * ny - view[2].z
  if dy > -0.01 { return false }
  let t = EYE_Y / -dy
  aim_x = dx * t
  aim_z = EYE_Z + dz * t
  return true
}

fn update_sparks(dt: f32) {
  let all = sparks.items as *Spark
  let i = sparks.count
  while i > 0 {                         // backwards, because removing moves the last one into the gap
    i -= 1
    let s = &all[i]
    s.life -= dt
    if s.life <= 0.0 {
      list_remove(sparks, i)
      continue
    }
    s.vy -= 22.0 * dt
    s.x += s.vx * dt
    s.y += s.vy * dt
    s.z += s.vz * dt
    if s.y < 0.06 {
      s.y = 0.06
      s.vy = s.vy * -0.45
    }
  }
}

// ---- drawing: every object is one instance of the cube

struct Instance {
  x: f32, y: f32, z: f32, turn: f32          // place
  sx: f32, sy: f32, sz: f32, unused: f32     // size
  r: f32, g: f32, b: f32, glow: f32          // color
}

extern fn Math.tan(x: f64): f64
const FOCAL = (1.0 / tan(42.0 * PI / 360.0)) as f32
const EYE_Y = 23.0               // the camera sits above and behind the floor's near edge
const EYE_Z = 15.0

var view_width: f32 = 1          // the canvas in CSS pixels, the unit pointer positions come in
var view_height: f32 = 1
var view_aspect: f32 = 1
var view_focal: f32 = 1

static scene: [f32x4; 5]               // view_projection (4 columns), light: mirrors scene.wgsl
static projection: [f32x4; 4]
static view: [f32x4; 4]
static frame: [Arena; 1]               // each frame's instances are built here, then forgotten

var pipeline: ext
var bind_group: ext
var vertex_buffer: ext
var index_buffer: ext
var instance_buffer: ext
var scene_buffer: ext
var color_target: ext
var depth_target: ext
var color_attachment: ext
var depth_attachment: ext
var pass_descriptor: ext

const MOST_INSTANCES = 8 + MOST_HAZARDS + ORBS + MOST_SPARKS

fn scene_init() {
  let module = createShaderModule(gpu_device, { code: embed("scene.wgsl") })
  pipeline = createRenderPipeline(gpu_device, {
    layout: "auto"
    vertex: {
      module
      buffers: [
        { arrayStride: sizeof(Vertex), attributes: [
          { shaderLocation: 0, offset: 0, format: "float32x3" }
          { shaderLocation: 1, offset: 12, format: "float32x3" }
        ] }
        { arrayStride: sizeof(Instance), stepMode: "instance", attributes: [
          { shaderLocation: 2, offset: 0, format: "float32x4" }
          { shaderLocation: 3, offset: 16, format: "float32x4" }
          { shaderLocation: 4, offset: 32, format: "float32x4" }
        ] }
      ]
    }
    fragment: { module, targets: [{ format: gpu_format }] }
    primitive: { cullMode: "back" }
    depthStencil: { format: "depth24plus", depthWriteEnabled: true, depthCompare: "less" }
    multisample: { count: 4 }
  })
  vertex_buffer = gpu_buffer(cube_vertices as i32, sizeof(Vertex) * 24, VERTEX)
  index_buffer = gpu_buffer(cube_indices as i32, 72, INDEX)
  instance_buffer = createBuffer(gpu_device, { size: MOST_INSTANCES * sizeof(Instance), usage: VERTEX | COPY_DST })
  scene_buffer = createBuffer(gpu_device, { size: 80, usage: UNIFORM | COPY_DST })
  bind_group = createBindGroup(gpu_device, {
    layout: getBindGroupLayout(pipeline, 0)
    entries: [{ binding: 0, resource: { buffer: scene_buffer } }]
  })
  color_attachment = { clearValue: [0.035, 0.04, 0.055, 1], loadOp: "clear", storeOp: "discard" }
  depth_attachment = { depthClearValue: 1, depthLoadOp: "clear", depthStoreOp: "discard" }
  pass_descriptor = { colorAttachments: [color_attachment], depthStencilAttachment: depth_attachment }

  arena_init(frame, MOST_INSTANCES * sizeof(Instance))
  mat4_look_at(view, 0, EYE_Y, EYE_Z, 0, 0, 1.2)
  scene[4] = f32x4(0.35, 0.85, 0.4, 0)
  on(window, "resize", scene_resize)
  scene_resize()
}

fn scene_resize() {
  gpu_fit()
  if truthy(color_target) {
    destroy_texture(color_target)
    destroy_texture(depth_target)
  }
  color_target = createTexture(gpu_device, { size: [gpu_width, gpu_height], sampleCount: 4, format: gpu_format, usage: RENDER_ATTACHMENT })
  depth_target = createTexture(gpu_device, { size: [gpu_width, gpu_height], sampleCount: 4, format: "depth24plus", usage: RENDER_ATTACHMENT })
  set_prop(color_attachment, "view", createView(color_target))
  set_prop(depth_attachment, "view", createView(depth_target))

  view_width = clientWidth(gpu_canvas) as f32
  view_height = clientHeight(gpu_canvas) as f32
  view_aspect = gpu_width as f32 / gpu_height as f32
  view_focal = view_aspect < 1.25 ? FOCAL * view_aspect / 1.25 : FOCAL      // on a narrow screen, zoom out to keep the floor in view
  mat4_perspective(projection, view_focal, view_aspect, 1, 100)
  mat4_mul(scene, projection, view)
  writeBuffer(gpu_queue, scene_buffer, 0, memory_buffer(), scene as i32, 80)
}

inline fn put(at: *Instance, x: f32, y: f32, z: f32, turn: f32, sx: f32, sy: f32, sz: f32, r: f32, g: f32, b: f32, glow: f32) {
  at[0] = Instance(x, y, z, turn, sx, sy, sz, 0, r, g, b, glow)
}

// Called by std/loop once per displayed frame. `blend` is how far we are between two ticks.
fn render(blend: f32) {
  if state != PLAYING { blend = 1.0 }          // nothing is moving: draw where things are
  arena_reset(frame)
  let count = 6 + hazards.count + orbs.count + sparks.count
  let out = arena_alloc(frame, count * sizeof(Instance)) as *Instance
  let n = 0

  put(&out[0], 0, -0.1, 0, 0, FIELD, 0.1, FIELD, 0.13, 0.15, 0.21, 0)                       // floor
  put(&out[1], 0, 0.15, -FIELD - 0.2, 0, FIELD + 0.4, 0.35, 0.2, 0.2, 0.23, 0.32, 0)        // walls
  put(&out[2], 0, 0.15, FIELD + 0.2, 0, FIELD + 0.4, 0.35, 0.2, 0.2, 0.23, 0.32, 0)
  put(&out[3], -FIELD - 0.2, 0.15, 0, 0, 0.2, 0.35, FIELD, 0.2, 0.23, 0.32, 0)
  put(&out[4], FIELD + 0.2, 0.15, 0, 0, 0.2, 0.35, FIELD, 0.2, 0.23, 0.32, 0)
  n = 5

  if state != OVER {
    let x = player_was_x + (player_x - player_was_x) * blend
    let z = player_was_z + (player_z - player_was_z) * blend
    put(&out[n], x, PLAYER_SIZE, z, player_vx * -0.04, PLAYER_SIZE, PLAYER_SIZE, PLAYER_SIZE, 0.91, 0.38, 0.23, 0.05)
    n += 1
  }

  let hs = hazards.items as *Hazard
  for i in 0..hazards.count {
    let h = &hs[i]
    let x = h.was_x + (h.x - h.was_x) * blend
    let z = h.was_z + (h.z - h.was_z) * blend
    put(&out[n], x, HAZARD_SIZE, z, clock * 1.3 + i as f32, HAZARD_SIZE, HAZARD_SIZE, HAZARD_SIZE, 0.28, 0.2, 0.42, 0)
    n += 1
  }

  let os = orbs.items as *Orb
  for i in 0..orbs.count {
    let bob = sin(clock * 3.0 + i as f32 * 2.0) * 0.12
    put(&out[n], os[i].x, 0.55 + bob, os[i].z, clock * 2.0, ORB_SIZE, ORB_SIZE, ORB_SIZE, 1.0, 0.85, 0.3, 0.55)
    n += 1
  }

  let ss = sparks.items as *Spark
  for i in 0..sparks.count {
    let s = &ss[i]
    let size = min(s.life, 0.4) * 0.22
    put(&out[n], s.x, s.y, s.z, s.life * 9.0, size, size, size, s.r, s.g, s.b, 0.6)
    n += 1
  }

  writeBuffer(gpu_queue, instance_buffer, 0, memory_buffer(), out as i32, n * sizeof(Instance))
  set_prop(color_attachment, "resolveTarget", createView(getCurrentTexture(gpu_context)))
  let encoder = createCommandEncoder(gpu_device)
  let pass = beginRenderPass(encoder, pass_descriptor)
  setPipeline(pass, pipeline)
  setBindGroup(pass, 0, bind_group)
  setVertexBuffer(pass, 0, vertex_buffer)
  setVertexBuffer(pass, 1, instance_buffer)
  setIndexBuffer(pass, index_buffer, "uint16")
  drawIndexed(pass, 36, n)
  end(pass)
  submit(gpu_queue, [finish(encoder)])
}
