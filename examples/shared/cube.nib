// A unit cube (corners at ±1) with face normals, built by the compiler and shipped as data.

struct Vertex { px: f32, py: f32, pz: f32, nx: f32, ny: f32, nz: f32 }

static cube_vertices: [Vertex; 24] = comptime cube_build_vertices
static cube_indices: [u16; 36] = comptime cube_build_indices

fn cube_build_vertices(out: *Vertex) {
  for face in 0..6 {
    let axis = face >> 1
    let side = face & 1 == 0 ? 1.0 : -1.0
    for corner in 0..4 {
      let v = &out[face * 4 + corner] as *f32
      let a = corner == 1 || corner == 2 ? 1.0 : -1.0
      let b = corner >= 2 ? 1.0 : -1.0
      v[axis] = side                        // position: the face's plane...
      v[(axis + 1) % 3] = a * side          // ...and a counter-clockwise walk around it
      v[(axis + 2) % 3] = b
      v[3 + axis] = side                    // normal
    }
  }
}

fn cube_build_indices(out: *u16) {
  for face in 0..6 {
    let v = face * 4
    let i = &out[face * 6]
    i[0] = v
    i[1] = v + 1
    i[2] = v + 2
    i[3] = v
    i[4] = v + 2
    i[5] = v + 3
  }
}
